meta {
  name: Browse products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/catalog/products?pageSize=5
  body: none
  auth: none
}

params:query {
  pageSize: 5
}

assert {
  res.status: eq 200
  res.body.page: eq 1
  res.body.pageSize: eq 5
  res.body.total: gte 1
  res.body.hasPreviousPage: eq false
}

script:post-response {
  // Handed to "Get one product by slug". Slugs are generated by the seed, so capturing one
  // here is what keeps the next request from hard-coding a value that would 404 in CI.
  bru.setVar("catalogSlug", res.body.items[0].slug);

  // Handed to "Category facets add up", which cross-checks the facet counts against this
  // number instead of against a constant that would rot with the seed.
  bru.setVar("catalogTotal", res.body.total);
}

tests {
  test("returns no more rows than the page size asked for", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.at.most(5);
    expect(res.body.items.length).to.be.above(0);
  });

  test("a summary is renderable on its own: identity, price and image", function() {
    const first = res.body.items[0];
    expect(first.id).to.be.a("string");
    expect(first.slug).to.match(/^[a-z0-9-]+$/);
    expect(first.name).to.be.a("string").and.not.be.empty;
    expect(first.category).to.be.a("string").and.not.be.empty;
    expect(first.variantCount).to.be.above(0);
  });

  test("money is minor units plus a preformatted string, never a float", function() {
    const price = res.body.items[0].fromPrice;
    expect(price.amount).to.be.a("number");
    expect(Number.isInteger(price.amount)).to.equal(true);
    expect(price.currency).to.equal("USD");
    expect(price.display).to.match(/^\$\d[\d,]*\.\d{2}$/);
  });

  test("paging metadata is self-consistent", function() {
    const b = res.body;
    expect(b.totalPages).to.equal(Math.ceil(b.total / b.pageSize));
    expect(b.hasNextPage).to.equal(b.page < b.totalPages);
  });
}

docs {
  The grid request. Asserts the envelope rather than the contents, so it survives a reseed.
}
