meta {
  name: Buy an order to cancel
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/checkout
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "paymentScenario": "Succeed",
    "shippingAddress": {
      "recipient": "Grace Hopper",
      "line1": "1 Quay Street",
      "city": "Bristol",
      "postalCode": "BS1 4RN",
      "countryCode": "GB"
    }
  }
}

assert {
  res.status: eq 201
  res.body.status: eq Paid
}

script:post-response {
  bru.setVar("cancelOrder", res.body.orderNumber);
  bru.setVar("cancelCaptured", res.body.captured.amount);
}
