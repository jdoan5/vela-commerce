meta {
  name: Run the oversell scenario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/demo/lab/run/oversell
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.scenarioId: eq oversell
  res.body.verdict.held: eq true
}

tests {
  test("the invariant held, and every check that says so passed", function() {
    // held is a roll-up. Asserting the individual checks as well is what stops a verdict
    // that is true because it was computed over an empty list.
    expect(res.body.verdict.checks.length).to.be.above(0);

    for (const check of res.body.verdict.checks) {
      expect(check.passed, check.claim + " | expected " + check.expected + " | actual " + check.actual)
        .to.equal(true);
    }
  });

  test("it raced against stock it made itself", function() {
    // A public button that consumed real inventory would empty the shelf for every other
    // visitor. The run seeds a private product, races that, and destroys it before it
    // answers - so the fixture slug is its own, not one from the catalog.
    expect(res.body.fixture.productSlug).to.match(/^demo-lab-/);
    expect(res.body.fixture.variants.length).to.be.above(0);
  });

  test("it touched nothing that belongs to anybody else", function() {
    expect(res.body.evidence.blastRadius.sharedCatalogRowsTouched).to.equal(0);
  });

  test("the transcript shows real exchanges, not a narrative", function() {
    // Each step carries the request and the response that actually happened. A lab that
    // described what it would have done would be a slide deck.
    expect(res.body.steps.length).to.be.above(0);
    expect(res.body.provenBy).to.match(/^tests\/.+\.cs$/);
  });
}
