@*
    The footer closes the page with the same enamel navy as the header, so the paper
    catalog sits between two painted boards. It also states, in plain words, the one
    architectural fact this whole storefront is built around.
*@
@inject CatalogService Catalog

<footer class="vc-footer">
    <div class="vc-container">
        <div class="vc-footer__grid">
            <div class="vc-footer__col">
                <a class="vc-wordmark" href="">
                    <VelaMark Class="vc-wordmark__mark" />
                    <span class="vc-wordmark__text">
                        <span class="vc-wordmark__name">Vela Commerce</span>
                        <span class="vc-wordmark__tag">Ship Chandlery &middot; Est. 1946</span>
                    </span>
                </a>
                <p class="vc-footer__blurb">
                    Rope, deck hardware, foul-weather gear, charts and lamps, held in stock and
                    sold by people who have used them. This entire catalog is served as a static
                    file, so the shop opens whether or not anything behind it is awake.
                </p>

                @* The lab's one entry point, and deliberately here rather than in the shelf
                   navigation above: it is for somebody reviewing the build, not for somebody
                   buying rope, and putting it in .vc-nav would push a shelf off the row on a
                   phone to make room for a page no shopper wants. It sits directly under the
                   sentence that states this shop's one architectural claim, because the lab is
                   where the rest of the claims are demonstrated rather than asserted. *@
                <a class="vc-footer__lab" href="lab">
                    <svg viewBox="0 0 16 16" width="13" height="13" fill="none" aria-hidden="true" focusable="false">
                        <path d="M6.5 1.5v4.2L2.8 12.4A1.2 1.2 0 0 0 3.9 14.2h8.2a1.2 1.2 0 0 0 1.1-1.8L9.5 5.7V1.5"
                              stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                        <path d="M5.2 1.5h5.6M4.6 9.4h6.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
                    </svg>
                    Demo lab
                </a>
                <p class="vc-footer__lab-note">
                    Press a button and watch an invariant hold: fifty shoppers racing for five
                    units, a double-clicked Pay, a settlement delivered twice. Real requests, real
                    transcripts, and the test that proves the same thing in CI.
                </p>
            </div>

            <div class="vc-footer__col">
                <h2>The shelves</h2>
                <ul class="vc-footer__list">
                    @foreach (var category in Catalog.Categories.Take(4))
                    {
                        <li><a href="@($"c/{category.Slug}")">@category.Name</a></li>
                    }
                </ul>
            </div>

            <div class="vc-footer__col">
                <h2>More</h2>
                <ul class="vc-footer__list">
                    @foreach (var category in Catalog.Categories.Skip(4))
                    {
                        <li><a href="@($"c/{category.Slug}")">@category.Name</a></li>
                    }
                </ul>
            </div>
        </div>

        <div class="vc-footer__base">
            <span>&copy; @Year Vela Commerce</span>
            <span>A portfolio build &middot; nothing here ships</span>
            @if (Catalog.Snapshot is { } snapshot)
            {
                <span class="vc-tabular">
                    Catalog @snapshot.ProductCount products &middot; @snapshot.VariantCount SKUs &middot;
                    snapshot seed @snapshot.RandomSeed
                </span>
            }
        </div>
    </div>
</footer>

@code {
    // DateTime.UtcNow rather than a literal so the notice cannot go stale, and UTC rather
    // than local time so it does not depend on the visitor's clock.
    private static int Year => DateTime.UtcNow.Year;

    // Awaiting the same shared load task the header and the page await: one fetch, and this
    // component re-renders with the shelf list once it completes.
    protected override Task OnInitializedAsync() => Catalog.EnsureLoadedAsync();
}
