@*
    The app shell's header: wordmark, one search field, a cart badge and the category
    navigation. Rendered before the catalog has loaded, with the nav row already at its
    final height, so the shell does not resize under the shopper when data arrives.
*@
@implements IDisposable
@inject CatalogService Catalog
@inject StorefrontState State
@inject CartDrawerState Drawer
@inject NavigationManager Nav

<header class="vc-header">
    <div class="vc-container">
        <div class="vc-header__bar">
            <div class="vc-header__brand">
                <a class="vc-wordmark" href="" aria-label="Vela Commerce, home">
                    <VelaMark Class="vc-wordmark__mark" />
                    <span class="vc-wordmark__text">
                        <span class="vc-wordmark__name">Vela Commerce</span>
                        <span class="vc-wordmark__tag">Ship Chandlery &middot; Est. 1946</span>
                    </span>
                </a>
            </div>

            <div class="vc-header__search-slot">
                <div class="vc-search">
                    <svg class="vc-search__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                        <circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.4" />
                        <path d="M10.6 10.6 14.5 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
                    </svg>
                    <label class="vc-visually-hidden" for="vc-search-input">Search the catalog</label>
                    @* The placeholder ends in a literal ellipsis, not &hellip;. Blazor sets
                       attributes through the DOM, so an entity here would reach the shopper
                       as those eight characters. *@
                    <input id="vc-search-input"
                           class="vc-search__input"
                           type="search"
                           autocomplete="off"
                           spellcheck="false"
                           placeholder="Search rope, lamps, charts, SKUs…"
                           value="@State.SearchTerm"
                           @oninput="OnSearchInput" />
                    @if (State.HasSearch)
                    {
                        <button type="button" class="vc-search__clear" @onclick="ClearSearch" aria-label="Clear search">
                            <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true" focusable="false">
                                <path d="M3 3l10 10M13 3 3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
                            </svg>
                        </button>
                    }
                </div>
            </div>

            <div class="vc-header__tools">
                @* A button, not a link: it opens a dialog in place rather than navigating.
                   The name is given outright rather than assembled from an icon, a word and
                   a badge — "Cart, 3 items" reads as a sentence and still contains the
                   visible word, which is what "label in name" asks for. *@
                <button type="button"
                        class="vc-cart-button"
                        @ref="_cartButton"
                        @onclick="ToggleCart"
                        aria-label="@CartLabel"
                        aria-haspopup="dialog"
                        aria-expanded="@(Drawer.IsOpen ? "true" : "false")"
                        aria-controls="vc-cart-drawer">
                    <svg class="vc-cart-button__icon" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
                        <path d="M2 2h2.2l2 9.2h8.1l1.7-6.7H5.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
                        <circle cx="7.3" cy="15" r="1.3" fill="currentColor" />
                        <circle cx="13.4" cy="15" r="1.3" fill="currentColor" />
                    </svg>
                    <span class="vc-cart-button__label">Cart</span>
                    <span class="vc-cart-button__count @(State.CartItemCount == 0 ? "vc-cart-button__count--empty" : null)">@State.CartItemCount</span>
                </button>
            </div>
        </div>
    </div>

    <div class="vc-header__nav-row">
        <div class="vc-container">
            <nav class="vc-nav" aria-label="Catalog categories">
                <NavLink class="vc-nav__link" ActiveClass="vc-nav__link--active" href="" Match="NavLinkMatch.All">
                    All stores
                </NavLink>
                @foreach (var category in Catalog.Categories)
                {
                    <NavLink class="vc-nav__link" ActiveClass="vc-nav__link--active"
                             href="@($"c/{category.Slug}")" Match="NavLinkMatch.Prefix">
                        @category.Name
                    </NavLink>
                }
                @if (Catalog.Categories.Count == 0)
                {
                    @* Placeholders hold the nav row's height while the snapshot loads. *@
                    @foreach (var width in NavPlaceholderWidths)
                    {
                        <span class="vc-nav__link" aria-hidden="true">
                            <span class="vc-skeleton vc-skeleton--line" style="display:block;width:@width;"></span>
                        </span>
                    }
                }
            </nav>
        </div>
    </div>
</header>

@code {
    // Literal strings, never a formatted double: WebAssembly picks up the browser's culture,
    // and a decimal comma inside a CSS length silently breaks the rule.
    private static readonly string[] NavPlaceholderWidths = ["4.5rem", "6rem", "5rem", "7rem", "5.5rem"];

    private ElementReference _cartButton;
    private bool _restoreFocus;

    private string CartLabel => State.CartItemCount switch
    {
        0 => "Cart, empty",
        1 => "Cart, 1 item",
        var n => $"Cart, {n} items",
    };

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Drawer.Changed += OnStateChanged;

        // A dialog hands focus back to whatever opened it, and the only thing that opens
        // the cart drawer is the button below. The drawer says when it has closed; the
        // focus call itself has to wait for a render, hence the flag.
        Drawer.Closed += OnDrawerClosed;

        // The nav is built from the snapshot, so the header waits on the same one-time load
        // the page does. Sharing the task means one fetch, not two.
        await Catalog.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_restoreFocus)
            return;

        _restoreFocus = false;

        try
        {
            await _cartButton.FocusAsync();
        }
        catch (Exception)
        {
            // Losing the focus handover is a nuisance, not a failure worth an error screen.
        }
    }

    private void OnStateChanged() => StateHasChanged();

    private void OnDrawerClosed()
    {
        _restoreFocus = true;
        StateHasChanged();
    }

    private void ToggleCart() => Drawer.Toggle();

    private void OnSearchInput(ChangeEventArgs args)
    {
        State.SetSearchTerm(args.Value as string);

        // Typing is a browse gesture. If the shopper is somewhere other than a catalog
        // route — a product page, the cart — send them back to the grid where the results
        // actually appear, replacing the entry so the back button still works sensibly.
        if (State.HasSearch && !IsCatalogRoute())
            Nav.NavigateTo("", replace: true);
    }

    private void ClearSearch() => State.ClearSearch();

    private bool IsCatalogRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var queryStart = path.IndexOf('?', StringComparison.Ordinal);
        if (queryStart >= 0)
            path = path[..queryStart];

        return path.Length == 0 || path.StartsWith("c/", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Drawer.Changed -= OnStateChanged;
        Drawer.Closed -= OnDrawerClosed;
    }
}
