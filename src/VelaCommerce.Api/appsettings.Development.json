{
  // No connection string here on purpose. It is machine-specific, so it lives in
  // user-secrets (dotnet user-secrets set "ConnectionStrings:Vela" "...") or in the
  // VELA_DB_CONNECTION environment variable, which Program.cs prefers. Committing one
  // would hard-code whoever happened to create the file and leak their local username.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
