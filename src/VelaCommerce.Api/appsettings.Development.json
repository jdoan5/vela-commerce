{
  // No connection string here on purpose. It is machine-specific, so it lives in
  // user-secrets (dotnet user-secrets set "ConnectionStrings:Vela" "...") or in the
  // VELA_DB_CONNECTION environment variable, which Program.cs prefers. Committing one
  // would hard-code whoever happened to create the file and leak their local username.
  // The simulator's magic amounts — where the trailing cents of the order total pick the
  // payment outcome — are a demo affordance, not a feature. On by default they made roughly
  // one real checkout in twenty decline or hang for no reason, because shipping and tax land
  // totals on every value of cents. Development only, where provoking a decline is the point.
  "Payments": {
    "Simulator": {
      "RecogniseMagicAmounts": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
