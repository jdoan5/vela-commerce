{
  "openapi": "3.1.1",
  "info": {
    "title": "VelaCommerce.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/catalog/products": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Browse the catalog",
        "description": "Returns a page of products with a variant count and a 'from' price. Paging inputs are clamped rather than rejected: page floors at 1 and pageSize is held to 1..100 (default 24), so a mistyped query string still renders a grid. Sort accepts 'name' (the default), 'price_asc' or 'price_desc'; anything unrecognised also falls back to 'name'. Every ordering carries a unique tiebreaker, so a product cannot appear on two pages or vanish between them.",
        "operationId": "ListProducts",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseOfProductSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/products/{slug}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Get one product by slug",
        "description": "Returns the product with every live variant, cheapest first, and each variant's current availability. Availability is a read-time snapshot for rendering only - the reservation that decides who actually gets the last unit happens at checkout. Responds 404 when the slug matches nothing live.",
        "operationId": "GetProductBySlug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/catalog/categories": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "List category facets",
        "description": "Returns every distinct category that still has at least one live product, with its product count, ordered by name. Counts are included so the storefront can grey out filters that lead nowhere without one request per facet.",
        "operationId": "ListCategories",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "VelaCommerce.Api"
        ],
        "summary": "Readiness probe: verifies the database is reachable.",
        "operationId": "Readiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryResponse": {
        "required": [
          "name",
          "productCount"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "productCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "MoneyDto": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "display": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PagedResponseOfProductSummaryResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductSummaryResponse"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalPages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hasPreviousPage": {
            "type": "boolean"
          },
          "hasNextPage": {
            "type": "boolean"
          }
        }
      },
      "ProductDetailResponse": {
        "required": [
          "id",
          "slug",
          "name",
          "description",
          "category",
          "attributes",
          "fromPrice",
          "variants"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "fromPrice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MoneyDto"
              }
            ]
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVariantResponse"
            }
          }
        }
      },
      "ProductSummaryResponse": {
        "required": [
          "id",
          "slug",
          "name",
          "description",
          "category",
          "variantCount",
          "fromPrice",
          "imageUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "variantCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "fromPrice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MoneyDto"
              }
            ]
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProductVariantResponse": {
        "required": [
          "id",
          "sku",
          "name",
          "price",
          "imageUrl",
          "available"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "available": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "inStock": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Catalog"
    },
    {
      "name": "VelaCommerce.Api"
    }
  ]
}