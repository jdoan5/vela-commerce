          },
          "line1": {
            "type": [
              "null",
              "string"
            ]
          },
          "line2": {
            "type": [
              "null",
              "string"
            ]
          },
          "city": {
            "type": [
              "null",
              "string"
            ]
          },
          "region": {
            "type": [
              "null",
              "string"
            ]
          },
          "postalCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "countryCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CheckoutAddressResponse": {
        "required": [
          "recipient",
          "line1",
          "line2",
          "city",
          "region",
          "postalCode",
          "countryCode"
        ],
        "type": "object",
        "properties": {
          "recipient": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": [
              "null",
              "string"
            ]
          },
          "city": {
            "type": "string"
          },
          "region": {
            "type": [
              "null",
              "string"
            ]
          },
          "postalCode": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          }
        }
      },
      "CheckoutOrderLineResponse": {
        "required": [
          "variantId",
          "sku",
          "displayName",
